---
// 홈 첫 화면 오른쪽 "연재 중인 시리즈" 카드. 시리즈마다 이름, 발행 편수, 진행 막대.
import type { SeriesInfo } from '../lib/series';
import { seriesEntryUrl } from '../lib/series';

interface Props {
	series: SeriesInfo[];
}

const { series } = Astro.props;
---

<aside class="series-card" aria-labelledby="series-card-label">
	<h2 id="series-card-label" class="eyebrow">연재 중인 시리즈</h2>
	<ul>
		{
			series.map((s) => (
				<li>
					<a href={seriesEntryUrl(s)}>
						<span class="row">
							<span class="name">{s.title}</span>
							<span class="count mono">
								{s.published} / {s.total}편{s.complete && ' 완결'}
							</span>
						</span>
						<span
							class:list={['bar', { complete: s.complete }]}
							role="progressbar"
							aria-label={`${s.title} 진행률`}
							aria-valuemin="0"
							aria-valuemax={s.total}
							aria-valuenow={s.published}
						>
							<span class="fill" style={`width: ${(s.published / s.total) * 100}%`} />
						</span>
					</a>
				</li>
			))
		}
	</ul>
</aside>

<style>
	.series-card {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 24px;
		border: 1px solid var(--c-border);
		border-radius: 12px;
		background: var(--c-bg);
	}
	.series-card .eyebrow {
		line-height: 1.5;
		letter-spacing: 0.5px;
	}
	ul {
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: flex;
		flex-direction: column;
		gap: 8px;
		color: var(--c-text-strong);
		text-decoration: none;
	}
	a:hover .name {
		text-decoration: underline;
		text-decoration-color: var(--c-accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}
	.row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
	}
	.name {
		font-size: 16px;
		font-weight: 600;
	}
	.count {
		flex-shrink: 0;
		font-size: 13px;
		color: var(--c-text-muted);
	}
	.bar {
		display: block;
		height: 6px;
		border-radius: 9999px;
		background: var(--c-divider);
		overflow: hidden;
	}
	.fill {
		display: block;
		height: 100%;
		border-radius: 9999px;
		background: var(--c-accent);
	}
	/* 완결은 검정으로 꽉 채운다 */
	.complete .fill {
		background: var(--c-text-strong);
	}
</style>
