---
import { NAV_ITEMS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<div class="bar container">
		<a class="logo" href="/">
			<span class="dot" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>
		<nav aria-label="사이트 메뉴">
			{NAV_ITEMS.map((item) => <HeaderLink class="nav-link" href={item.href} match={item.match}>{item.label}</HeaderLink>)}
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--c-divider);
		background: var(--c-bg);
	}
	.bar {
		min-height: 64px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		color: var(--c-text-strong);
		font-size: 16px;
		font-weight: 600;
		text-decoration: none;
	}
	.dot {
		width: 10px;
		height: 10px;
		border-radius: 9999px;
		background: var(--c-accent);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	nav :global(.nav-link) {
		display: flex;
		align-items: center;
		min-height: 40px;
		padding: 0 12px;
		border-radius: 8px;
		color: var(--c-text-muted);
		font-size: 14px;
		text-decoration: none;
	}
	nav :global(.nav-link:hover) {
		color: var(--c-text-strong);
	}
	nav :global(.nav-link.active) {
		background: var(--c-surface);
		color: var(--c-text-strong);
		font-weight: 500;
	}

	/* 휴대폰: 첫 줄 로고(52px), 둘째 줄 메뉴 탭(44px). 넘치면 가로로 밀어 본다 */
	@media (max-width: 720px) {
		.bar {
			display: block;
			padding: 0;
		}
		.logo {
			min-height: 52px;
			padding: 0 var(--container-pad);
		}
		nav {
			padding: 0 8px;
			overflow-x: auto;
			white-space: nowrap;
		}
		nav :global(.nav-link) {
			min-height: 44px;
			border-radius: 0;
			font-size: 15px;
		}
		nav :global(.nav-link.active) {
			background: none;
			font-weight: 600;
			box-shadow: inset 0 -2px 0 var(--c-text-strong);
		}
	}
</style>
