---
// 글 화면. PC는 왼쪽 메뉴 200 / 본문 720 / 목차 200, 칸 사이 40.
// 1264px(1200 + 좌우 여백)보다 좁으면 목차 칸을 접힌 메뉴로 옮기고, 960px 이하에서는 왼쪽 메뉴도 옮겨 한 칸이 된다.
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import CategoryList from '../components/post/CategoryList.astro';
import PostNeighbors from '../components/post/PostNeighbors.astro';
import SeriesNav from '../components/post/SeriesNav.astro';
import Toc from '../components/post/Toc.astro';
import { SITE_TITLE } from '../consts';
import { categoryUrl } from '../lib/categories';
import { type Neighbors, notebookUrl, type SeriesInfo } from '../lib/series';

interface Props {
	post: CollectionEntry<'blog'>;
	series?: SeriesInfo;
	neighbors: Neighbors;
	headings: MarkdownHeading[];
}

const { post, series, neighbors, headings } = Astro.props;
const { title, description, category, pubDate, updatedDate, heroImage, env, notebook, seriesOrder } = post.data;
const neighborIds = [neighbors.prev, neighbors.next].flatMap((n) => (n.kind === 'post' ? [n.post.id] : []));
---

<html lang="ko">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class="post-page container">
			<aside class="left-col">
				<div class="sticky">
					{series && <SeriesNav series={series} current={seriesOrder!} />}
					<CategoryList current={category} showAll={!series} />
				</div>
			</aside>

			<article class="main-col">
				<header class="post-head">
					<p class="crumbs">
						<a href="/blog/">블로그</a>
						<span aria-hidden="true">/</span>
						<a class="chip" href={categoryUrl(category)}>{category}</a>
					</p>
					<h1>{title}</h1>
					<p class="lead">{description}</p>
					<div class="meta">
						<FormattedDate class="date" date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									<Icon name="rotate-ccw" size={12} />
									<FormattedDate date={updatedDate} /> 수정
								</span>
							)
						}
						{
							env?.map((v) => (
								<span class="env mono">{v}</span>
							))
						}
					</div>
				</header>

				{
					(series || headings.length > 0) && (
						<div class="menu-box">
							{series && (
								<details class="series-menu">
									<summary>
										<span class="summary-title">{series.title} 시리즈</span>
										<span class="mono summary-count">
											{seriesOrder} / {series.total}
										</span>
										<Icon name="chevron-down" size={16} class="chev" />
									</summary>
									<SeriesNav series={series} current={seriesOrder!} variant="compact" />
								</details>
							)}
							{headings.length > 0 && (
								<details class="toc-menu">
									<summary>
										<span class="summary-title">이 글의 목차</span>
										<span class="mono summary-count">{headings.length}</span>
										<Icon name="chevron-down" size={16} class="chev" />
									</summary>
									<Toc headings={headings} variant="compact" />
								</details>
							)}
						</div>
					)
				}

				{
					notebook && (
						<div class="notebook-card">
							<p>
								<Icon name="book" size={20} class="book" />
								<span>이 글의 코드와 수치는 노트북으로 직접 실행해 볼 수 있다.</span>
							</p>
							<a class="btn btn-primary" href={notebookUrl(post)} download>
								<Icon name="download" size={16} />
								노트북 내려받기
							</a>
						</div>
					)
				}

				<div class="prose">
					<slot />
				</div>

				<footer class="post-foot">
					<PostNeighbors neighbors={neighbors} inSeries={Boolean(series)} />
					<RelatedPosts category={category} exclude={[post.id, ...neighborIds]} />
				</footer>
			</article>

			{
				headings.length > 0 && (
					<aside class="toc-col">
						<div class="sticky">
							<Toc headings={headings} />
						</div>
					</aside>
				)
			}
		</main>
		<Footer />

		<script>
			// 목차의 현재 절 표시: 화면 위쪽 기준선을 지난 마지막 제목을 현재 절로 본다
			const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
			const slugs = [...new Set(links.map((a) => a.dataset.tocLink!))];
			const targets = slugs.map((s) => document.getElementById(s)).filter((el): el is HTMLElement => el !== null);
			let current: string | undefined;
			const update = () => {
				const line = 120;
				let active = targets[0]?.id;
				for (const el of targets) {
					if (el.getBoundingClientRect().top <= line) active = el.id;
					else break;
				}
				// 끝까지 내리면 마지막 절들은 기준선에 닿지 못하므로 마지막 절을 현재 절로 본다
				if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) {
					active = targets[targets.length - 1].id;
				}
				if (active === current) return;
				current = active;
				for (const a of links) a.classList.toggle('active', a.dataset.tocLink === active);
			};
			if (targets.length > 0) {
				let queued = false;
				addEventListener(
					'scroll',
					() => {
						if (queued) return;
						queued = true;
						requestAnimationFrame(() => {
							queued = false;
							update();
						});
					},
					{ passive: true },
				);
				update();
			}
			// 코드 블록 복사 버튼
			document.addEventListener('click', async (event) => {
				const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-copy]');
				if (!button) return;
				const code = button.closest('.code-block')?.querySelector('pre')?.textContent ?? '';
				try {
					await navigator.clipboard.writeText(code);
					button.textContent = '복사됨';
				} catch {
					button.textContent = '복사 실패';
				}
				setTimeout(() => (button.textContent = '복사'), 1500);
			});
			// 접힌 목차에서 항목을 고르면 메뉴를 닫는다
			for (const a of document.querySelectorAll<HTMLAnchorElement>('.toc-menu a')) {
				a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'));
			}
		</script>
	</body>
</html>

<style>
	.post-page {
		display: grid;
		grid-template-columns: 200px minmax(0, 720px) 200px;
		justify-content: center;
		align-items: start;
		gap: 40px;
		width: auto;
		max-width: var(--container-max);
		padding-top: 48px;
		padding-bottom: 96px;
	}
	.sticky {
		position: sticky;
		top: 24px;
		display: flex;
		flex-direction: column;
		gap: 28px;
		max-height: calc(100vh - 48px);
		overflow-y: auto;
	}
	.main-col {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	/* 본문 머리 */
	.post-head {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding-bottom: 8px;
	}
	.crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-size: 13px;
		color: var(--c-text-muted);
	}
	.crumbs a:not(.chip) {
		color: var(--c-text-muted);
		text-decoration: none;
	}
	.crumbs a:not(.chip):hover {
		color: var(--c-text-strong);
	}
	h1 {
		margin: 0;
	}
	.lead {
		margin: 0;
		font-size: 18px;
		line-height: 1.7;
		color: var(--c-text-secondary);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}
	.meta :global(.date) {
		margin-right: 8px;
		font-size: 13px;
		color: var(--c-text-muted);
	}
	.env {
		padding: 2px 6px;
		border-radius: 6px;
		background: var(--c-surface);
		font-size: 13px;
		color: var(--c-text-secondary);
	}
	.updated {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 1px 8px;
		border: 1px solid var(--c-border);
		border-radius: 6px;
		font-size: 12px;
		color: var(--c-text-muted);
	}
	.updated :global(time) {
		font-size: 12px;
	}

	/* 노트북 안내 카드 */
	.notebook-card {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 20px;
		border: 1px solid var(--c-border);
		border-radius: 12px;
	}
	.notebook-card p {
		flex: 1 1 320px;
		min-width: 0;
		display: flex;
		align-items: flex-start;
		gap: 12px;
		margin: 0;
		font-size: 15px;
		line-height: 1.65;
		color: var(--c-text-secondary);
	}
	.notebook-card :global(.book) {
		flex: 0 0 20px;
		margin-top: 2px;
		color: var(--c-text-strong);
	}
	.notebook-card .btn {
		font-size: 14px;
	}

	/* 접힌 메뉴(좁은 화면) */
	.menu-box {
		display: none;
		overflow: hidden;
		border: 1px solid var(--c-border);
		border-radius: 12px;
	}
	.menu-box details + details {
		border-top: 1px solid var(--c-border);
	}
	summary {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 52px;
		padding: 0 16px;
		font-size: 15px;
		font-weight: 600;
		color: var(--c-text-strong);
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	.summary-title {
		flex: 1 1 auto;
	}
	.summary-count {
		font-size: 13px;
		font-weight: 500;
		color: var(--c-text-muted);
	}
	summary :global(.chev) {
		color: var(--c-text-muted);
		transition: transform 0.15s;
	}
	details[open] > summary :global(.chev) {
		transform: rotate(180deg);
	}

	/* 글 하단 */
	.post-foot {
		display: flex;
		flex-direction: column;
		gap: 24px;
		margin-top: 40px;
		padding-top: 32px;
		border-top: 1px solid var(--c-border);
	}

	/* 1264px보다 좁으면 목차 칸을 접힌 메뉴로 */
	@media (max-width: 1263px) {
		.post-page {
			grid-template-columns: 200px minmax(0, 720px);
		}
		.toc-col {
			display: none;
		}
		.menu-box {
			display: block;
		}
		.series-menu {
			display: none;
		}
		.series-menu + .toc-menu {
			border-top: none;
		}
	}
	/* 960px 이하에서는 한 칸 */
	@media (max-width: 960px) {
		.post-page {
			grid-template-columns: minmax(0, 1fr);
		}
		.left-col {
			display: none;
		}
		.series-menu {
			display: block;
		}
		.series-menu + .toc-menu {
			border-top: 1px solid var(--c-border);
		}
	}
	@media (max-width: 720px) {
		.post-page {
			padding-top: 28px;
			padding-bottom: 56px;
		}
		.main-col {
			gap: 20px;
		}
		.post-head {
			gap: 14px;
		}
		.lead {
			font-size: 16px;
		}
		.env {
			font-size: 12px;
		}
		.notebook-card .btn {
			flex: 1 1 100%;
			min-height: 48px;
		}
	}
</style>
