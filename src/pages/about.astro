---
// 소개 페이지. 본문은 src/content/about.mdx에 마크다운으로 쓰고, 이 파일은 틀과 프로필 칸을 맡는다.
// PC: 왼쪽 제목·본문 + 오른쪽 프로필 칸. 휴대폰: 제목 → 프로필 칸 → 본문.
import BaseHead from '../components/BaseHead.astro';
import CertBadge from '../components/CertBadge.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { CERT, CONTACTS, PROFILE, SITE_TITLE } from '../consts';
import { Content, frontmatter } from '../content/about.mdx';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`소개 | ${SITE_TITLE}`} description={frontmatter.tagline} />
	</head>
	<body>
		<Header />
		<main class="about container">
			<div class="heading">
				<h1>{frontmatter.title}</h1>
				<p class="tagline">{frontmatter.tagline}</p>
			</div>

			<aside class="profile" aria-label="프로필">
				<div class="profile-card">
					<div class="who">
						<span class="initial" aria-hidden="true">{PROFILE.initial}</span>
						<span class="who-text">
							<span class="name">{PROFILE.name}</span>
							<span class="role">{PROFILE.role}</span>
						</span>
					</div>
					{PROFILE.summary.length > 0 && (
					<dl class="summary">
						{
							PROFILE.summary.map((s) => (
								<>
									<dt>{s.term}</dt>
									<dd>{s.desc}</dd>
								</>
							))
						}
					</dl>
					)}
					<ul class="contacts" aria-label="연락처">
						{
							CONTACTS.map((c) => (
								<li>
									<a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
										<Icon name={c.icon} size={20} />
										<span class="contact-text">
											<span class="contact-label">{c.label}</span>
											<span class="contact-value mono">{c.value}</span>
										</span>
										{c.external && (
											<>
												<Icon name="arrow-up-right" size={14} class="ext" />
												<span class="sr-only">(새 탭에서 열림)</span>
											</>
										)}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				{CERT && <CertBadge cert={CERT} />}
			</aside>

			<article class="body prose">
				<Content />
				<p class="cta">
					<a class="btn btn-primary" href="/blog/">블로그 글 보기</a>
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* PC: 왼쪽 720px(제목 + 본문), 오른쪽 프로필 칸 300~360px, 칸 사이 64px */
	.about {
		display: grid;
		grid-template-columns: minmax(0, 720px) minmax(300px, 360px);
		grid-template-areas:
			'heading profile'
			'body profile';
		grid-template-rows: auto 1fr;
		justify-content: space-between;
		column-gap: 64px;
		width: auto;
		max-width: var(--container-max);
		padding-top: 64px;
		padding-bottom: 96px;
	}
	.heading {
		grid-area: heading;
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding-bottom: 32px;
	}
	.profile {
		grid-area: profile;
		align-self: start;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.body {
		grid-area: body;
		min-width: 0;
	}
	h1 {
		margin: 0;
		font-size: 48px;
		line-height: 1.2;
		letter-spacing: -1.2px;
	}
	/* 나를 표현하는 한 문장: 왼쪽 강조색 세로선으로 인용처럼 보이게 한다 */
	.tagline {
		margin: 0;
		padding-left: 16px;
		border-left: 3px solid var(--c-accent);
		font-size: 20px;
		line-height: 1.6;
		color: var(--c-text-secondary);
	}

	/* ---------- 본문(mdx) ---------- */
	.body :global(h2) {
		margin-top: 2em;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--c-divider);
	}
	.body :global(h2:first-child) {
		margin-top: 0;
	}
	.cta {
		margin: 32px 0 0;
	}
	.cta .btn {
		color: var(--c-bg);
		text-decoration: none;
	}

	/* ---------- 프로필 칸 ---------- */
	.profile-card {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 24px;
		border: 1px solid var(--c-border);
		border-radius: 12px;
	}
	.who {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.initial {
		display: flex;
		flex: 0 0 48px;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 9999px;
		background: var(--c-text-strong);
		box-shadow: inset 0 0 0 3px var(--c-accent);
		color: var(--c-bg);
		font-size: 18px;
		font-weight: 600;
	}
	.who-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.name {
		font-size: 18px;
		font-weight: 600;
		color: var(--c-text-strong);
	}
	.role {
		font-size: 14px;
		color: var(--c-text-muted);
	}
	.summary {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 8px 16px;
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
	}
	.summary dt {
		color: var(--c-text-muted);
	}
	.summary dd {
		margin: 0;
		color: var(--c-text);
	}
	.contacts {
		display: flex;
		flex-direction: column;
		gap: 2px;
		margin: 0;
		padding: 16px 0 0;
		border-top: 1px solid var(--c-divider);
		list-style: none;
	}
	.contacts a {
		display: flex;
		align-items: center;
		gap: 12px;
		min-height: 44px;
		font-size: 14px;
		color: var(--c-text-strong);
		text-decoration: none;
	}
	.contacts a:hover .contact-label {
		text-decoration: underline;
		text-decoration-color: var(--c-accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}
	.contact-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.contact-label {
		font-weight: 500;
	}
	.contact-value {
		font-size: 12px;
		color: var(--c-text-muted);
		overflow-wrap: anywhere;
	}
	.contacts :global(.ext) {
		flex-shrink: 0;
		margin-left: auto;
		color: var(--c-text-muted);
	}

	/* 두 칸(720 + 64 + 300)과 바깥 여백이 들어가지 않는 폭부터 한 칸으로: 제목 → 프로필 → 본문 */
	@media (max-width: 1147px) {
		.about {
			grid-template-columns: minmax(0, 720px);
			grid-template-areas:
				'heading'
				'profile'
				'body';
			grid-template-rows: auto;
			justify-content: center;
		}
		.profile {
			margin-bottom: 40px;
		}
	}
	@media (max-width: 720px) {
		.about {
			padding-top: 40px;
			padding-bottom: 64px;
		}
		.heading {
			padding-bottom: 24px;
		}
		h1 {
			font-size: 32px;
			letter-spacing: -0.6px;
		}
		.tagline {
			font-size: 17px;
		}
		.cta .btn {
			width: 100%;
			min-height: 48px;
		}
	}
</style>
