---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LinkGrid from '../components/LinkGrid.astro';
import PostCardGrid from '../components/PostCardGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SeriesProgress from '../components/SeriesProgress.astro';
import { HOME_INTRO, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getAllSeries } from '../lib/series';

const RECENT_POSTS = 3;
const RECENT_LINKS = 3;

const allPosts = await getCollection('blog');
const posts = allPosts
	.toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id))
	.slice(0, RECENT_POSTS);
const links = (await getCollection('links'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, RECENT_LINKS);
const series = await getAllSeries(allPosts);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home container">
			<section class="hero">
				<div class="intro">
					<p class="label">{HOME_INTRO.label}</p>
					<h1>{HOME_INTRO.title.map((line, i) => (i === 0 ? line : <><br />{line}</>))}</h1>
					<p class="lead">{HOME_INTRO.lead}</p>
					<div class="btn-row">
						<a class="btn btn-primary" href="/blog/">블로그 읽기</a>
						<a class="btn btn-secondary" href="/about/">소개 더 보기</a>
					</div>
				</div>
				{series.length > 0 && <SeriesProgress series={series} />}
			</section>

			<section class="block">
				<SectionHeader title="최근 글" href="/blog/" linkLabel="전체 글 보기" />
				{posts.length > 0 ? <PostCardGrid posts={posts} /> : <p class="empty">아직 글이 없습니다.</p>}
			</section>

			<section class="block last">
				<SectionHeader title="스크랩" href="/links/" linkLabel="전체 스크랩 보기" />
				{links.length > 0 ? <LinkGrid links={links} showTags={false} /> : <p class="empty">아직 스크랩이 없습니다.</p>}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* 홈은 1200px 틀을 그대로 쓴다(전역 main의 720px 폭을 덮어쓴다) */
	.home {
		width: auto;
		max-width: var(--container-max);
		padding-top: 0;
		padding-bottom: 0;
	}
	.hero {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 48px;
		padding: 96px 0 64px;
		border-bottom: 1px solid var(--c-divider);
	}
	.intro {
		flex: 999 1 560px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.hero > :global(.series-card) {
		flex: 1 1 340px;
		min-width: 0;
	}
	.label {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.5px;
		color: var(--c-text-muted);
	}
	h1 {
		margin: 0;
		font-size: 56px;
		line-height: 1.15;
		letter-spacing: -1.5px;
	}
	.lead {
		margin: 0;
		max-width: 620px;
		font-size: 18px;
		line-height: 1.7;
		color: var(--c-text-secondary);
	}
	.btn-row {
		padding-top: 8px;
	}
	.block {
		display: flex;
		flex-direction: column;
		gap: 28px;
		padding: 64px 0;
	}
	.block.last {
		padding-top: 0;
		padding-bottom: 96px;
	}
	.empty {
		color: var(--c-text-muted);
	}
	@media (max-width: 720px) {
		.hero {
			gap: 36px;
			padding: 48px 0 48px;
		}
		h1 {
			font-size: 34px;
			line-height: 1.2;
			letter-spacing: -1px;
		}
		.lead {
			font-size: 16px;
		}
		.block {
			gap: 20px;
			padding: 48px 0;
		}
		.block.last {
			padding-bottom: 56px;
		}
	}
</style>
