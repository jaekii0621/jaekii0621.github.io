---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getNeighbors, getSeriesOf } from '../../lib/series';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const posts = await getCollection('blog');
const series = await getSeriesOf(post, posts);
const neighbors = await getNeighbors(post, posts);
// 목차는 h2·h3만. 각주 영역 제목(footnote-label)은 뺀다
const tocHeadings = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
---

<BlogPost post={post} series={series} neighbors={neighbors} headings={tocHeadings}>
	<Content />
</BlogPost>
